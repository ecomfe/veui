{
  "presets": [
    ["@babel/preset-env", { "modules": false }]
  ],
  "plugins": [
    [
      "@babel/transform-runtime",
      {
        "corejs": false,
        "regenerator": false
      }
    ]
  ],
  "comments": false,
  "env": {
    "test": {
      "presets": ["@babel/preset-env"]
    },
    "production": {
      "plugins": ["lodash"]
    },
    "development": {
      "plugins": ["lodash"]
    }
  }
}
